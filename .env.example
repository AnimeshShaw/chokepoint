# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only the providers you actually evaluate need keys. Local Ollama models
# require no key — just a running Ollama daemon (see docs/reproducing.md).

# ── Frontier providers ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# ── Local inference ──────────────────────────────────────────────────────────
# Override only if Ollama is not on the default host/port.
OLLAMA_BASE_URL=http://localhost:11434
